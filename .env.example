# Copia este archivo como .env y cambia los valores
PORT=3000
# Cadena larga y aleatoria. Nunca la subas a git.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=1h
# Origen del frontend permitido (solo para pruebas locales sin proxy)
CORS_ORIGIN=http://localhost:5173
# Usuario de prueba (se guarda hasheado en memoria)
DEMO_USER=admin
DEMO_PASSWORD=Admin123!
